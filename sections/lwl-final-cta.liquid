{%- style -%}
  #LwlFinalCta-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    position: relative;
    padding: 8rem 2rem;
    text-align: center;
    color: #ffffff;
    overflow: hidden;
    background: linear-gradient(180deg, #1f1515 0%, #c9332b 100%);
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__bg {
    position: absolute;
    inset: 0;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.88) 0%, rgba(237, 58, 49, 0.75) 100%);
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__heading {
    font-size: clamp(3rem, 5.5vw, 5rem);
    margin: 0 0 2rem;
    color: #fcc0c5;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__copy {
    font-size: 1.7rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 3.6rem;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__copy p {
    margin: 0 0 1.2rem;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__actions {
    display: flex;
    justify-content: center;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 700;
    font-size: 1.7rem;
    padding: 1.5rem 3.6rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button--primary {
    background: #fcc0c5;
    color: #121212;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button--secondary {
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    color: #ffffff;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button:hover {
    transform: translateY(-0.3rem);
  }

  /* image button: a pink pill that pulses to show it is clickable */
  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image {
    display: block;
    width: clamp(26rem, 38vw, 40rem);
    max-width: 100%;
    line-height: 0;
    -webkit-tap-highlight-color: transparent;
    transition: scale 0.25s ease;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image:hover,
  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image:focus-visible {
    scale: 1.06;
  }

  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image img {
    display: block;
    width: 100%;
    height: auto;
    /* crop away the transparent space above and below the pill */
    aspect-ratio: 1024 / 328;
    object-fit: cover;
    object-position: 50% 49.6%;
    animation: lwl-final-pulse 2.4s ease-in-out infinite;
  }

  @keyframes lwl-final-pulse {
    0%,
    100% {
      transform: scale(1);
      filter: drop-shadow(0 0 0.4rem rgba(252, 192, 197, 0.35));
    }
    50% {
      transform: scale(1.06);
      filter: drop-shadow(0 0 1.8rem rgba(252, 192, 197, 0.95));
    }
  }

  /* on click: press in, pop, then burst away; the link only opens once this has played */
  #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image.is-clicked img {
    animation: lwl-final-click 0.85s cubic-bezier(0.3, 0.7, 0.3, 1) forwards;
  }

  @keyframes lwl-final-click {
    0% {
      transform: scale(1);
      filter: drop-shadow(0 0 0.8rem rgba(252, 192, 197, 0.5));
      opacity: 1;
    }
    20% {
      transform: scale(0.92);
    }
    50% {
      transform: scale(1.14);
      filter: drop-shadow(0 0 3rem rgba(252, 192, 197, 1)) brightness(1.1);
    }
    75% {
      transform: scale(1.1);
      filter: drop-shadow(0 0 3rem rgba(252, 192, 197, 0.9));
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      filter: drop-shadow(0 0 4rem rgba(252, 192, 197, 0.9));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image,
    #LwlFinalCta-{{ section.id }} .lwl-final-cta__button-image img {
      animation: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlFinalCta-{{ section.id }}" class="lwl-final-cta">
  {%- if section.settings.background_image != blank -%}
    <div class="lwl-final-cta__bg">
      <img src="{{ section.settings.background_image | image_url: width: 1800 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}
  <div class="lwl-final-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lwl-final-cta__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.copy != blank -%}
      <div class="lwl-final-cta__copy">{{ section.settings.copy }}</div>
    {%- endif -%}
    <div class="lwl-final-cta__actions">
      {%- if section.settings.primary_image != blank and section.settings.primary_link != blank -%}
        <a href="{{ section.settings.primary_link }}" class="lwl-final-cta__button-image" data-lwl-cta-image>
          <img
            src="{{ section.settings.primary_image | image_url: width: 900 }}"
            srcset="{{ section.settings.primary_image | image_url: width: 600 }} 600w, {{ section.settings.primary_image | image_url: width: 900 }} 900w"
            sizes="(min-width: 750px) 40rem, 80vw"
            alt="{{ section.settings.primary_label | default: 'Reserve your seat' | escape }}"
            width="1024"
            height="328"
            loading="lazy"
          >
        </a>
      {%- elsif section.settings.primary_label != blank and section.settings.primary_link != blank -%}
        <a href="{{ section.settings.primary_link }}" class="lwl-final-cta__button lwl-final-cta__button--primary">
          {{ section.settings.primary_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="lwl-final-cta__button lwl-final-cta__button--secondary">
          {{ section.settings.secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('LwlFinalCta-{{ section.id }}');
    if (!root) return;

    // The image button plays its click animation first, then opens the link.
    var cta = root.querySelector('[data-lwl-cta-image]');
    if (!cta) return;
    var clicked = false;

    cta.addEventListener('click', function (event) {
      // let new-tab / modified clicks behave like a normal link
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      event.preventDefault();
      if (clicked) return;
      clicked = true;
      cta.classList.add('is-clicked');

      var opened = false;
      function openLink() {
        if (opened) return;
        opened = true;
        window.location.href = cta.href;
      }

      var img = cta.querySelector('img');
      if (img) img.addEventListener('animationend', openLink, { once: true });
      window.setTimeout(openLink, 1100); // safety net if animationend never fires
    });

    // a bfcache restore (Back button) should not leave the button mid-animation
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) {
        clicked = false;
        cta.classList.remove('is-clicked');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "LWL Final CTA",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Next Connection Could Change Everything" },
    { "type": "richtext", "id": "copy", "label": "Copy" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Register Now", "info": "Used as the text button, and as the image's accessible name." },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "image_picker", "id": "primary_image", "label": "Primary button image", "info": "Replaces the text button. It pulses, and plays a click animation before opening the link." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Join The Community" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "LWL Final CTA" }
  ]
}
{% endschema %}
