{%- style -%}
  #LwlSlider-{{ section.id }} {
    position: relative;
    height: 70vh;
    min-height: 40rem;
    overflow: hidden;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__slide.is-active {
    opacity: 1;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(18, 18, 18, 0.7) 0%, rgba(18, 18, 18, 0.1) 50%);
  }

  #LwlSlider-{{ section.id }} .lwl-slider__caption {
    position: absolute;
    left: 3rem;
    bottom: 3rem;
    z-index: 1;
    color: #ffffff;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    max-width: 60rem;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__arrow:hover {
    background: #ed3a31;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__arrow--prev {
    left: 2rem;
  }

  #LwlSlider-{{ section.id }} .lwl-slider__arrow--next {
    right: 2rem;
  }
{%- endstyle -%}

<div id="LwlSlider-{{ section.id }}" class="lwl-slider" data-lwl-swipe>
  {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}
      <div class="lwl-slider__slide{% if forloop.first %} is-active{% endif %}" data-lwl-slide>
        <img
          src="{{ block.settings.image | image_url: width: 1800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        >
        <div class="lwl-slider__scrim"></div>
        {%- if block.settings.caption != blank -%}
          <p class="lwl-slider__caption">{{ block.settings.caption | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
  <button type="button" class="lwl-slider__arrow lwl-slider__arrow--prev" data-lwl-prev aria-label="Previous slide">&larr;</button>
  <button type="button" class="lwl-slider__arrow lwl-slider__arrow--next" data-lwl-next aria-label="Next slide">&rarr;</button>
</div>

<script>
  (function () {
    var root = document.getElementById('LwlSlider-{{ section.id }}');
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-lwl-slide]'));
    if (!slides.length) return;

    var current = 0;
    var timer;

    function goTo(index) {
      slides[current].classList.remove('is-active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('is-active');
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function restart() {
      clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    root.querySelector('[data-lwl-next]').addEventListener('click', function () { next(); restart(); });
    root.querySelector('[data-lwl-prev]').addEventListener('click', function () { prev(); restart(); });

    var touchStartX = null;
    root.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; });
    root.addEventListener('touchend', function (e) {
      if (touchStartX === null) return;
      var diff = e.changedTouches[0].clientX - touchStartX;
      if (diff > 40) { prev(); restart(); }
      if (diff < -40) { next(); restart(); }
      touchStartX = null;
    });

    restart();
  })();
</script>

{% schema %}
{
  "name": "LWL Slider",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Slider",
      "blocks": [
        { "type": "slide", "settings": { "caption": "4 Years Strong" } },
        { "type": "slide", "settings": { "caption": "Inspiring Women Leaders" } },
        { "type": "slide", "settings": { "caption": "Meaningful Connections" } },
        { "type": "slide", "settings": { "caption": "Growing Community" } },
        { "type": "slide", "settings": { "caption": "Countless Collaborations" } }
      ]
    }
  ]
}
{% endschema %}
