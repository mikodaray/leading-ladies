{%- liquid
  assign mf_title = product.metafields.custom.title.value
  assign mf_tagline = product.metafields.custom.title_description.value
  if mf_title == blank
    assign mf_title = product.title
  endif
  if mf_tagline == blank
    assign mf_tagline = product.description | strip_html | truncatewords: 28
  endif
  assign title_words = mf_title | split: ' '
-%}

{%- style -%}
  #PeHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 9rem 2rem 0;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(135deg, #121212 0%, #3a0f10 45%, #ed3a31 130%);
    background-size: 160% 160%;
    animation: pe-bg-shift 14s ease-in-out infinite;
  }

  @keyframes pe-bg-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  #PeHero-{{ section.id }} .pe-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }

  #PeHero-{{ section.id }} .pe-hero__glow--1 {
    width: 30rem;
    height: 30rem;
    top: -10rem;
    left: -8rem;
    background: rgba(252, 192, 197, 0.35);
    animation: pe-float-a 15s ease-in-out infinite;
  }

  #PeHero-{{ section.id }} .pe-hero__glow--2 {
    width: 26rem;
    height: 26rem;
    bottom: 6rem;
    right: -6rem;
    background: rgba(237, 58, 49, 0.45);
    animation: pe-float-b 18s ease-in-out infinite;
  }

  @keyframes pe-float-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(3rem, 4rem) scale(1.15);
    }
  }

  @keyframes pe-float-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-3rem, -3rem) scale(1.2);
    }
  }

  #PeHero-{{ section.id }} .pe-hero__spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(28rem circle at var(--pe-mx, 50%) var(--pe-my, 35%), rgba(252, 192, 197, 0.22), transparent 65%);
  }

  #PeHero-{{ section.id }} .pe-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 96rem;
    margin: 0 auto;
  }

  #PeHero-{{ section.id }} .pe-hero__eyebrow {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.3rem;
    text-transform: uppercase;
    padding: 0.6rem 1.8rem;
    border: 1.5px dashed rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    margin-bottom: 2.6rem;
    opacity: 0;
    animation: pe-fade-up 0.8s ease forwards 0.1s;
  }

  #PeHero-{{ section.id }} .pe-hero__title {
    font-size: clamp(4rem, 9vw, 9.6rem);
    line-height: 0.95;
    margin: 0 0 2.4rem;
  }

  #PeHero-{{ section.id }} .pe-hero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.14em;
    margin-right: 0.22em;
  }

  #PeHero-{{ section.id }} .pe-hero__word > span {
    display: inline-block;
    transform: translateY(115%);
    animation: pe-rise 0.95s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(0.2s + var(--i) * 0.12s);
  }

  @keyframes pe-rise {
    to {
      transform: translateY(0);
    }
  }

  @keyframes pe-fade-up {
    from {
      opacity: 0;
      transform: translateY(1.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #PeHero-{{ section.id }} .pe-hero__tagline {
    font-size: clamp(1.7rem, 2.4vw, 2.4rem);
    line-height: 1.5;
    max-width: 64rem;
    margin: 0 auto 3.2rem;
    color: rgba(255, 255, 255, 0.88);
    opacity: 0;
    animation: pe-fade-up 0.9s ease forwards 0.75s;
  }

  #PeHero-{{ section.id }} .pe-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: pe-fade-up 0.9s ease forwards 0.95s;
  }

  #PeHero-{{ section.id }} .pe-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: #ffffff;
    color: #ed3a31;
    font-weight: 700;
    font-size: 1.6rem;
    padding: 1.4rem 3.2rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #PeHero-{{ section.id }} .pe-hero__cta:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 1.4rem 3rem rgba(0, 0, 0, 0.4);
  }

  #PeHero-{{ section.id }} .pe-hero__price {
    font-size: 2.2rem;
    color: #fcc0c5;
  }

  #PeHero-{{ section.id }} .pe-hero__ticker {
    position: relative;
    z-index: 1;
    margin: 7rem -2rem 0;
    overflow: hidden;
    background: #ed3a31;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  #PeHero-{{ section.id }} .pe-hero__ticker-track {
    display: flex;
    width: max-content;
    padding: 1.4rem 0;
    animation: pe-marquee 34s linear infinite;
  }

  #PeHero-{{ section.id }} .pe-hero__ticker:hover .pe-hero__ticker-track {
    animation-play-state: paused;
  }

  #PeHero-{{ section.id }} .pe-hero__ticker-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2.4rem;
    padding-right: 2.4rem;
    font-size: 1.9rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #PeHero-{{ section.id }} .pe-hero__ticker-star {
    color: #fcc0c5;
  }

  @keyframes pe-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PeHero-{{ section.id }},
    #PeHero-{{ section.id }} * {
      animation: none !important;
    }
    #PeHero-{{ section.id }} .pe-hero__word > span {
      transform: none;
    }
    #PeHero-{{ section.id }} .pe-hero__eyebrow,
    #PeHero-{{ section.id }} .pe-hero__tagline,
    #PeHero-{{ section.id }} .pe-hero__actions {
      opacity: 1;
    }
  }
{%- endstyle -%}

<div id="PeHero-{{ section.id }}" class="pe-hero">
  <div class="pe-hero__glow pe-hero__glow--1"></div>
  <div class="pe-hero__glow pe-hero__glow--2"></div>
  <div class="pe-hero__spot"></div>

  <div class="pe-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="pe-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    <h1 class="pe-hero__title" aria-label="{{ mf_title | escape }}">
      {%- for word in title_words -%}
        <span class="pe-hero__word" aria-hidden="true"><span style="--i: {{ forloop.index0 }}">{{ word | escape }}</span></span>{{ ' ' }}
      {%- endfor -%}
    </h1>

    {%- if mf_tagline != blank -%}
      <p class="pe-hero__tagline">{{ mf_tagline | escape }}</p>
    {%- endif -%}

    <div class="pe-hero__actions">
      {%- if section.settings.cta_label != blank -%}
        <a href="#ProductInfo-main" class="pe-hero__cta" data-pe-scroll>
          {{ section.settings.cta_label | escape }}
          <span aria-hidden="true">&darr;</span>
        </a>
      {%- endif -%}
      <span class="pe-hero__price">{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>
  </div>

  <div class="pe-hero__ticker" aria-hidden="true">
    <div class="pe-hero__ticker-track">
      {%- for i in (1..2) -%}
        <div class="pe-hero__ticker-group">
          {%- for n in (1..8) -%}
            <span>{{ mf_title | escape }}</span>
            <span class="pe-hero__ticker-star">&#10022;</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var hero = document.getElementById('PeHero-{{ section.id }}');
    if (!hero) return;

    document.querySelectorAll('[data-pe-scroll]').forEach(function (link) {
      link.addEventListener('click', function (event) {
        var target = document.querySelector('.product__info-container');
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var raf = null;
    hero.addEventListener('pointermove', function (event) {
      if (raf) return;
      raf = requestAnimationFrame(function () {
        var rect = hero.getBoundingClientRect();
        hero.style.setProperty('--pe-mx', event.clientX - rect.left + 'px');
        hero.style.setProperty('--pe-my', event.clientY - rect.top + 'px');
        raf = null;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Event product hero",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Leading Ladies Presents"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label (scrolls to the buy box)",
      "default": "Reserve your spot"
    }
  ],
  "presets": [
    {
      "name": "Event product hero"
    }
  ]
}
{% endschema %}
