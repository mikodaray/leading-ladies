{%- style -%}
  #LwlStatements-{{ section.id }} {
    padding: 6rem 2rem;
    background: #121212;
    text-align: center;
  }

  #LwlStatements-{{ section.id }} .lwl-statements__heading {
    color: #ffffff;
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    margin: 0 0 4rem;
  }

  #LwlStatements-{{ section.id }} .lwl-statements__grid {
    max-width: 110rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: 2.4rem;
  }

  #LwlStatements-{{ section.id }} .lwl-statements__card {
    position: relative;
    border-radius: 1.6rem;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(2.4rem) scale(0.97);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  #LwlStatements-{{ section.id }} .lwl-statements__card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  #LwlStatements-{{ section.id }} .lwl-statements__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #LwlStatements-{{ section.id }} .lwl-statements__card:hover img {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlStatements-{{ section.id }} .lwl-statements__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlStatements-{{ section.id }}" class="lwl-statements">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-statements__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-statements__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <div class="lwl-statements__card" data-lwl-reveal {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 800 }} 800w"
            sizes="(min-width: 750px) 33vw, 90vw"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var cards = document.querySelectorAll('#LwlStatements-{{ section.id }} [data-lwl-reveal]');
    if (!cards.length) return;
    if (!('IntersectionObserver' in window)) {
      cards.forEach(function (c) { c.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 120);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    cards.forEach(function (c) { observer.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "LWL Statements",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In Their Own Words" }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Statements",
      "blocks": [
        { "type": "statement" },
        { "type": "statement" },
        { "type": "statement" }
      ]
    }
  ]
}
{% endschema %}
