{%- style -%}
  #LwlExperience-{{ section.id }} {
    padding: 6rem 2rem;
    background: #fcc0c5;
    text-align: center;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__heading {
    color: #ffffff;
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    margin: 0 0 4rem;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__grid {
    max-width: 100rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 3.2rem 2rem;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item {
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  #LwlExperience-{{ section.id }} .lwl-experience__circle {
    width: 9rem;
    height: 9rem;
    margin: 0 auto 1.6rem;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.4rem;
    box-shadow: 0 1rem 2.5rem rgba(18, 18, 18, 0.15);
    transition: transform 0.3s ease;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item:hover .lwl-experience__circle {
    transform: scale(1.08) rotate(-4deg);
  }

  #LwlExperience-{{ section.id }} .lwl-experience__label {
    color: #ffffff;
    font-size: 1.7rem;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlExperience-{{ section.id }} .lwl-experience__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlExperience-{{ section.id }}" class="lwl-experience">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-experience__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-experience__grid">
    {%- for block in section.blocks -%}
      <div class="lwl-experience__item" data-lwl-reveal {{ block.shopify_attributes }}>
        <div class="lwl-experience__circle" aria-hidden="true">{{ block.settings.icon }}</div>
        <p class="lwl-experience__label">{{ block.settings.label | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var items = document.querySelectorAll('#LwlExperience-{{ section.id }} [data-lwl-reveal]');
    if (!items.length) return;
    if (!('IntersectionObserver' in window)) {
      items.forEach(function (c) { c.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    items.forEach(function (c) { observer.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "LWL Experience",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What To Expect" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✨" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Experience",
      "blocks": [
        { "type": "item", "settings": { "icon": "🤝", "label": "Networking Sessions" } },
        { "type": "item", "settings": { "icon": "🎙️", "label": "Founder Conversations" } },
        { "type": "item", "settings": { "icon": "🎤", "label": "Leadership Panels" } },
        { "type": "item", "settings": { "icon": "🚀", "label": "Collaboration Opportunities" } },
        { "type": "item", "settings": { "icon": "🫶", "label": "Community Building" } },
        { "type": "item", "settings": { "icon": "💫", "label": "Inspiring Stories" } }
      ]
    }
  ]
}
{% endschema %}
