{%- style -%}
  #LwlSocialProof-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #ffffff;
    text-align: center;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #121212;
    margin: 0 0 4rem;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__masonry {
    max-width: 130rem;
    margin: 0 auto;
    columns: 4 18rem;
    column-gap: 1.4rem;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__item {
    position: relative;
    break-inside: avoid;
    margin-bottom: 1.4rem;
    border-radius: 1.2rem;
    overflow: hidden;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__item:hover img {
    transform: scale(1.08);
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.6rem;
    background: linear-gradient(180deg, transparent 40%, rgba(18, 18, 18, 0.75) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__item:hover .lwl-social__overlay {
    opacity: 1;
  }

  #LwlSocialProof-{{ section.id }} .lwl-social__overlay-text {
    color: #ffffff;
    font-size: 1.6rem;
    margin: 0;
    text-align: left;
  }

  @media screen and (max-width: 600px) {
    #LwlSocialProof-{{ section.id }} .lwl-social__overlay {
      opacity: 1;
    }
  }
{%- endstyle -%}

<div id="LwlSocialProof-{{ section.id }}" class="lwl-social">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-social__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-social__masonry">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <div class="lwl-social__item" {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
          >
          {%- if block.settings.overlay_text != blank -%}
            <div class="lwl-social__overlay">
              <p class="lwl-social__overlay-text">{{ block.settings.overlay_text | escape }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "LWL Social Proof",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built Through Real Connections" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overlay_text", "label": "Overlay text (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Social Proof",
      "blocks": [
        { "type": "image", "settings": { "overlay_text": "Partnerships Started Here" } },
        { "type": "image", "settings": { "overlay_text": "Mentorships Created Here" } },
        { "type": "image", "settings": { "overlay_text": "Friendships Built Here" } },
        { "type": "image", "settings": { "overlay_text": "Women Supporting Women" } },
        { "type": "image", "settings": { "overlay_text": "Ideas Turned Into Businesses" } },
        { "type": "image", "settings": { "overlay_text": "Connections That Last" } },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
