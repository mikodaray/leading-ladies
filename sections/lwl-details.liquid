{%- style -%}
  #LwlDetails-{{ section.id }} {
    padding: 6rem 2rem;
    background: #fff5f5;
    text-align: center;
  }

  #LwlDetails-{{ section.id }} .lwl-details__inner {
    max-width: 90rem;
    margin: 0 auto;
  }

  #LwlDetails-{{ section.id }} .lwl-details__heading {
    font-size: clamp(3rem, 5vw, 4.8rem);
    color: #ed3a31;
    margin: 0 0 3rem;
  }

  #LwlDetails-{{ section.id }} .lwl-details__ticket {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    background: #ffffff;
    border-radius: 1.6rem;
    box-shadow: 0 1.5rem 4rem rgba(237, 58, 49, 0.15);
    margin-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }

  #LwlDetails-{{ section.id }} .lwl-details__ticket-item {
    padding: 2.4rem 3.2rem;
    min-width: 20rem;
    border-left: 2px dashed rgba(237, 58, 49, 0.2);
  }

  #LwlDetails-{{ section.id }} .lwl-details__ticket-item:first-child {
    border-left: none;
  }

  #LwlDetails-{{ section.id }} .lwl-details__ticket-label {
    display: block;
    font-size: 1.2rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: #ed3a31;
    opacity: 0.7;
    margin-bottom: 0.6rem;
  }

  #LwlDetails-{{ section.id }} .lwl-details__ticket-value {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    color: #121212;
  }

  #LwlDetails-{{ section.id }} .lwl-details__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 2.4rem;
  }

  #LwlDetails-{{ section.id }} .lwl-details__card {
    background: #ffffff;
    border-radius: 1.6rem;
    padding: 3.2rem 2.4rem;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.06);
    opacity: 0;
    transform: translateY(2.4rem);
    transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.3s ease;
  }

  #LwlDetails-{{ section.id }} .lwl-details__card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #LwlDetails-{{ section.id }} .lwl-details__card.is-visible:hover {
    box-shadow: 0 1.6rem 3.5rem rgba(237, 58, 49, 0.18);
    transform: translateY(-0.6rem);
  }

  #LwlDetails-{{ section.id }} .lwl-details__card-icon {
    font-size: 3.6rem;
    display: block;
    margin-bottom: 1.6rem;
  }

  #LwlDetails-{{ section.id }} .lwl-details__card-title {
    font-size: 2.2rem;
    margin: 0 0 1rem;
    color: #121212;
  }

  #LwlDetails-{{ section.id }} .lwl-details__card-text {
    font-size: 1.5rem;
    color: rgba(18, 18, 18, 0.7);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #LwlDetails-{{ section.id }} .lwl-details__ticket-item {
      min-width: 100%;
      border-left: none;
      border-top: 1px dashed rgba(237, 58, 49, 0.2);
    }
    #LwlDetails-{{ section.id }} .lwl-details__ticket-item:first-child {
      border-top: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlDetails-{{ section.id }} .lwl-details__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlDetails-{{ section.id }}" class="lwl-details">
  <div class="lwl-details__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lwl-details__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="lwl-details__ticket">
      {%- if section.settings.date_label != blank -%}
        <div class="lwl-details__ticket-item">
          <span class="lwl-details__ticket-label">Date</span>
          <span class="lwl-details__ticket-value">{{ section.settings.date_label | escape }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.time_label != blank -%}
        <div class="lwl-details__ticket-item">
          <span class="lwl-details__ticket-label">Time</span>
          <span class="lwl-details__ticket-value">{{ section.settings.time_label | escape }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.venue_label != blank -%}
        <div class="lwl-details__ticket-item">
          <span class="lwl-details__ticket-label">Venue</span>
          <span class="lwl-details__ticket-value">{{ section.settings.venue_label | escape }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lwl-details__grid">
        {%- for block in section.blocks -%}
          <div class="lwl-details__card" data-lwl-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="lwl-details__card-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="lwl-details__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="lwl-details__card-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var cards = document.querySelectorAll('#LwlDetails-{{ section.id }} [data-lwl-reveal]');
    if (!cards.length) return;

    if (!('IntersectionObserver' in window)) {
      cards.forEach(function (card) {
        card.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry, index) {
          if (entry.isIntersecting) {
            setTimeout(function () {
              entry.target.classList.add('is-visible');
            }, index * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    cards.forEach(function (card) {
      observer.observe(card);
    });
  })();
</script>

{% schema %}
{
  "name": "LWL Details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What To Expect"
    },
    {
      "type": "text",
      "id": "date_label",
      "label": "Date",
      "default": "November 14, 2026"
    },
    {
      "type": "text",
      "id": "time_label",
      "label": "Time",
      "default": "10:00 AM – 4:00 PM"
    },
    {
      "type": "text",
      "id": "venue_label",
      "label": "Venue",
      "default": "Greyhound Cafe, Ayala Triangle Gardens, Makati City"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Details",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "icon": "🎤",
            "title": "Power Panels",
            "text": "Deep dive discussions with successful women entrepreneurs sharing their journeys."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "💡",
            "title": "Skill Labs",
            "text": "Interactive workshops to level up your business game."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "🤝",
            "title": "Connection Corner",
            "text": "Structured networking sessions to build meaningful relationships."
          }
        }
      ]
    }
  ]
}
{% endschema %}
