{%- liquid
  assign story = product.metafields.custom.product_description_1.value
  assign includes = product.metafields.custom.product_description_2.value
  assign closing = product.metafields.custom.product_description_3.value
  assign extra = product.metafields.custom.product_description_4.value

  assign has_metafields = false
  if story != blank or includes != blank or closing != blank or extra != blank
    assign has_metafields = true
  endif

  assign story_words = story | newline_to_br | replace: '<br />', ' ' | split: ' '

  assign include_lines = includes | newline_to_br | split: '<br />'
  assign heading_line = ''
  for line in include_lines
    assign l = line | strip
    if l != blank
      assign last_char = l | slice: -1
      if last_char == ':'
        assign heading_line = l
      endif
      break
    endif
  endfor
  if heading_line != blank
    assign heading_text = heading_line | remove_last: ':'
  else
    assign heading_text = section.settings.includes_fallback_heading
  endif
-%}

{%- style -%}
  #PeDetails-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
  }

  #PeDetails-{{ section.id }} .pe-story {
    position: relative;
    padding: 9rem 2rem;
    background: #fff5f5;
  }

  #PeDetails-{{ section.id }} .pe-story__inner {
    position: relative;
    max-width: 92rem;
    margin: 0 auto;
  }

  #PeDetails-{{ section.id }} .pe-story__mark {
    position: absolute;
    top: -5.6rem;
    left: -1rem;
    font-size: 18rem;
    line-height: 1;
    color: #ed3a31;
    opacity: 0.18;
    pointer-events: none;
  }

  #PeDetails-{{ section.id }} .pe-story__text {
    position: relative;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
    line-height: 1.25;
    margin: 0;
    color: #121212;
  }

  #PeDetails-{{ section.id }} .pe-story__word {
    display: inline-block;
    opacity: 0.18;
    transform: translateY(0.3rem);
    transition: opacity 0.35s ease, transform 0.35s ease, color 0.35s ease;
  }

  #PeDetails-{{ section.id }} .pe-story__word.is-lit {
    opacity: 1;
    transform: translateY(0);
  }

  #PeDetails-{{ section.id }} .pe-includes {
    padding: 8rem 2rem;
    background: #121212;
    color: #ffffff;
  }

  #PeDetails-{{ section.id }} .pe-includes__inner {
    max-width: 92rem;
    margin: 0 auto;
  }

  #PeDetails-{{ section.id }} .pe-includes__label {
    font-size: clamp(2.8rem, 4.4vw, 4.4rem);
    color: #fcc0c5;
    margin: 0 0 4rem;
  }

  #PeDetails-{{ section.id }} .pe-includes__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  #PeDetails-{{ section.id }} .pe-includes__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2.4rem;
    padding: 2.6rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    opacity: 0;
    transform: translateX(-2.4rem);
    transition: opacity 0.6s ease, transform 0.6s ease, background-color 0.3s ease, padding-left 0.3s ease;
    transition-delay: calc(var(--i) * 90ms), calc(var(--i) * 90ms), 0s, 0s;
  }

  #PeDetails-{{ section.id }} .pe-includes__item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  #PeDetails-{{ section.id }} .pe-includes__item.is-visible:hover {
    background-color: rgba(252, 192, 197, 0.08);
    padding-left: 2.4rem;
  }

  #PeDetails-{{ section.id }} .pe-includes__num {
    flex: 0 0 auto;
    width: 5rem;
    font-size: 1.6rem;
    letter-spacing: 0.15rem;
    color: rgba(255, 255, 255, 0.4);
  }

  #PeDetails-{{ section.id }} .pe-includes__check {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background: #ed3a31;
  }

  #PeDetails-{{ section.id }} .pe-includes__check svg {
    width: 2.2rem;
    height: 2.2rem;
    fill: none;
    stroke: #ffffff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #PeDetails-{{ section.id }} .pe-includes__check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  #PeDetails-{{ section.id }} .pe-includes__item.is-visible .pe-includes__check path {
    animation: pe-draw 0.6s ease forwards;
    animation-delay: calc(var(--i) * 90ms + 0.35s);
  }

  @keyframes pe-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  #PeDetails-{{ section.id }} .pe-includes__text {
    font-size: clamp(1.9rem, 2.6vw, 2.8rem);
    line-height: 1.3;
  }

  @property --pe-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  #PeDetails-{{ section.id }} .pe-closing {
    padding: 8rem 2rem;
    background: radial-gradient(60rem circle at 50% 0%, #ff6a5f 0%, #ed3a31 55%, #b01f18 130%);
  }

  #PeDetails-{{ section.id }} .pe-closing__card {
    position: relative;
    isolation: isolate;
    max-width: 78rem;
    margin: 0 auto;
    padding: 5rem 3.4rem;
    border-radius: 2.4rem;
    text-align: center;
    color: #ffffff;
    opacity: 0;
    transform: translateY(2.4rem) scale(0.97);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  #PeDetails-{{ section.id }} .pe-closing__card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  #PeDetails-{{ section.id }} .pe-closing__card::before {
    content: '';
    position: absolute;
    inset: -3px;
    z-index: -2;
    border-radius: inherit;
    background: conic-gradient(from var(--pe-angle), #fcc0c5, #ed3a31, #ffffff, #fcc0c5);
    animation: pe-spin 5s linear infinite;
  }

  #PeDetails-{{ section.id }} .pe-closing__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #121212;
  }

  @keyframes pe-spin {
    to {
      --pe-angle: 360deg;
    }
  }

  #PeDetails-{{ section.id }} .pe-closing__text {
    font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    line-height: 1.35;
    margin: 0 0 3.2rem;
  }

  #PeDetails-{{ section.id }} .pe-closing__button {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: #fcc0c5;
    color: #121212;
    font-weight: 700;
    font-size: 1.7rem;
    padding: 1.5rem 3.6rem;
    border-radius: 999px;
    text-decoration: none;
    animation: pe-pulse 2.4s ease-in-out infinite;
    transition: transform 0.25s ease;
  }

  #PeDetails-{{ section.id }} .pe-closing__button:hover {
    transform: translateY(-0.3rem);
  }

  @keyframes pe-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(252, 192, 197, 0.55);
    }
    50% {
      box-shadow: 0 0 0 1.2rem rgba(252, 192, 197, 0);
    }
  }

  #PeDetails-{{ section.id }} .pe-closing__fine {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 2.8rem 0 0;
  }

  #PeDetails-{{ section.id }} .pe-fallback {
    padding: 6rem 2rem;
  }

  @media screen and (max-width: 749px) {
    #PeDetails-{{ section.id }} .pe-story,
    #PeDetails-{{ section.id }} .pe-includes,
    #PeDetails-{{ section.id }} .pe-closing {
      padding-top: 5.6rem;
      padding-bottom: 5.6rem;
    }
    #PeDetails-{{ section.id }} .pe-story__mark {
      font-size: 11rem;
      top: -3.4rem;
    }
    #PeDetails-{{ section.id }} .pe-includes__num {
      display: none;
    }
    #PeDetails-{{ section.id }} .pe-closing__card {
      padding: 3.6rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PeDetails-{{ section.id }} .pe-story__word,
    #PeDetails-{{ section.id }} .pe-includes__item,
    #PeDetails-{{ section.id }} .pe-closing__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #PeDetails-{{ section.id }} .pe-includes__check path {
      stroke-dashoffset: 0;
    }
    #PeDetails-{{ section.id }} .pe-closing__card::before,
    #PeDetails-{{ section.id }} .pe-closing__button {
      animation: none;
    }
  }
{%- endstyle -%}

<div id="PeDetails-{{ section.id }}" class="pe-details">
  {%- if has_metafields -%}
    {%- if story != blank -%}
      <section class="pe-story" data-pe-story>
        <div class="pe-story__inner">
          <span class="pe-story__mark" aria-hidden="true">&ldquo;</span>
          <p class="pe-story__text">
            <span class="visually-hidden">{{ story | escape }}</span>
            <span aria-hidden="true">
              {%- for word in story_words -%}
                {%- assign w = word | strip -%}
                {%- if w != blank -%}
                  <span class="pe-story__word" data-pe-word>{{ w | escape }}</span>{{ ' ' }}
                {%- endif -%}
              {%- endfor -%}
            </span>
          </p>
        </div>
      </section>
    {%- endif -%}

    {%- if includes != blank -%}
      <section class="pe-includes">
        <div class="pe-includes__inner">
          <h2 class="pe-includes__label">{{ heading_text | escape }}</h2>
          <ul class="pe-includes__list">
            {%- assign n = 0 -%}
            {%- for line in include_lines -%}
              {%- assign l = line | strip -%}
              {%- if l == blank or l == heading_line -%}
                {%- continue -%}
              {%- endif -%}
              <li class="pe-includes__item" data-pe-reveal style="--i: {{ n }}">
                <span class="pe-includes__num">{{ n | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
                <span class="pe-includes__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path></svg>
                </span>
                <span class="pe-includes__text">{{ l | escape }}</span>
              </li>
              {%- assign n = n | plus: 1 -%}
            {%- endfor -%}
          </ul>
        </div>
      </section>
    {%- endif -%}

    {%- if closing != blank or extra != blank -%}
      <section class="pe-closing">
        <div class="pe-closing__card" data-pe-reveal>
          {%- if closing != blank -%}
            <p class="pe-closing__text">{{ closing | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if section.settings.closing_button_label != blank -%}
            <a href="#ProductInfo-main" class="pe-closing__button" data-pe-scroll>
              {{ section.settings.closing_button_label | escape }}
              <span aria-hidden="true">&uarr;</span>
            </a>
          {%- endif -%}
          {%- if extra != blank -%}
            <p class="pe-closing__fine">{{ extra | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  {%- else -%}
    <div class="pe-fallback page-width rte">{{ product.description }}</div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('PeDetails-{{ section.id }}');
    if (!root) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    root.querySelectorAll('[data-pe-scroll]').forEach(function (link) {
      link.addEventListener('click', function (event) {
        var target = document.querySelector('.product__info-container');
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    var reveals = root.querySelectorAll('[data-pe-reveal]');
    if (reveals.length) {
      if (!('IntersectionObserver' in window) || reduceMotion) {
        reveals.forEach(function (el) { el.classList.add('is-visible'); });
      } else {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.25 });
        reveals.forEach(function (el) { observer.observe(el); });
      }
    }

    var story = root.querySelector('[data-pe-story]');
    var words = Array.prototype.slice.call(root.querySelectorAll('[data-pe-word]'));
    if (story && words.length) {
      if (reduceMotion) {
        words.forEach(function (w) { w.classList.add('is-lit'); });
        return;
      }

      var ticking = false;

      function update() {
        var rect = story.getBoundingClientRect();
        var vh = window.innerHeight;
        var progress = (vh * 0.85 - rect.top) / (rect.height * 0.9);
        progress = Math.max(0, Math.min(1, progress));
        var lit = Math.round(progress * words.length);
        for (var i = 0; i < words.length; i++) {
          words[i].classList.toggle('is-lit', i < lit);
        }
        ticking = false;
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  })();
</script>

{% schema %}
{
  "name": "Event product details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "includes_fallback_heading",
      "label": "Included-items heading (used when the list has no heading line)",
      "default": "What's included"
    },
    {
      "type": "text",
      "id": "closing_button_label",
      "label": "Closing button label (scrolls to the buy box)",
      "default": "Reserve your spot"
    }
  ],
  "presets": [
    {
      "name": "Event product details"
    }
  ]
}
{% endschema %}
