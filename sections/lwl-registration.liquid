{%- style -%}
  #LwlRegistration-{{ section.id }} {
    padding: 6rem 2rem;
    background: #fff5f5;
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__inner {
    max-width: 64rem;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 1.6rem;
    padding: 4rem 3.2rem;
    box-shadow: 0 1.5rem 4rem rgba(237, 58, 49, 0.12);
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__heading {
    text-align: center;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    color: #ed3a31;
    margin: 0 0 0.8rem;
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__subheading {
    text-align: center;
    font-size: 1.5rem;
    color: rgba(18, 18, 18, 0.65);
    margin: 0 0 3.2rem;
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
  }

  #LwlRegistration-{{ section.id }} .field {
    margin-bottom: 1.6rem;
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__submit {
    width: 100%;
    padding: 1.5rem;
    border-radius: 999px;
    border: none;
    background: #ed3a31;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.6rem;
    cursor: pointer;
    transition: transform 0.25s ease;
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__submit:hover {
    transform: translateY(-0.2rem);
  }

  #LwlRegistration-{{ section.id }} .lwl-registration__success {
    text-align: center;
    font-size: 1.7rem;
    color: #ed3a31;
  }

  @media screen and (max-width: 600px) {
    #LwlRegistration-{{ section.id }} .lwl-registration__row {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div id="LwlRegistration-{{ section.id }}" class="lwl-registration">
  <div class="lwl-registration__inner">
    <h2 class="lwl-registration__heading">{{ section.settings.heading | escape }}</h2>
    <p class="lwl-registration__subheading">{{ section.settings.subheading | escape }}</p>

    {%- form 'contact', id: 'LwlRegistrationForm-{{ section.id }}' -%}
      <input type="hidden" name="contact[tags]" value="ladies-who-launch-season-4-registration">
      {%- if form.posted_successfully? -%}
        <p class="lwl-registration__success">{{ section.settings.success_message | escape }}</p>
      {%- else -%}
        <div class="lwl-registration__row">
          <div class="field">
            <input class="field__input" type="text" id="LwlReg-FirstName-{{ section.id }}" name="contact[First Name]" placeholder="First Name" required>
            <label class="field__label" for="LwlReg-FirstName-{{ section.id }}">First Name</label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="LwlReg-LastName-{{ section.id }}" name="contact[Last Name]" placeholder="Last Name" required>
            <label class="field__label" for="LwlReg-LastName-{{ section.id }}">Last Name</label>
          </div>
        </div>
        <div class="lwl-registration__row">
          <div class="field">
            <input class="field__input" type="email" id="LwlReg-Email-{{ section.id }}" name="contact[email]" placeholder="Email" required>
            <label class="field__label" for="LwlReg-Email-{{ section.id }}">Email</label>
          </div>
          <div class="field">
            <input class="field__input" type="tel" id="LwlReg-Mobile-{{ section.id }}" name="contact[phone]" placeholder="Mobile Number" required>
            <label class="field__label" for="LwlReg-Mobile-{{ section.id }}">Mobile Number</label>
          </div>
        </div>
        <div class="lwl-registration__row">
          <div class="field">
            <input class="field__input" type="text" id="LwlReg-Company-{{ section.id }}" name="contact[Company / Business]" placeholder="Company / Business">
            <label class="field__label" for="LwlReg-Company-{{ section.id }}">Company / Business</label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="LwlReg-Industry-{{ section.id }}" name="contact[Industry]" placeholder="Industry">
            <label class="field__label" for="LwlReg-Industry-{{ section.id }}">Industry</label>
          </div>
        </div>
        <div class="field">
          <input class="field__input" type="text" id="LwlReg-LinkedIn-{{ section.id }}" name="contact[LinkedIn Profile]" placeholder="LinkedIn Profile (Optional)">
          <label class="field__label" for="LwlReg-LinkedIn-{{ section.id }}">LinkedIn Profile (Optional)</label>
        </div>
        <button type="submit" class="lwl-registration__submit">{{ section.settings.button_label | escape }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "LWL Registration",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reserve Your Spot" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Spots are limited — save yours for Ladies Who Launch Season 4." },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Reserve My Spot" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in! We'll be in touch with all the details soon." }
  ],
  "presets": [
    { "name": "LWL Registration" }
  ]
}
{% endschema %}
