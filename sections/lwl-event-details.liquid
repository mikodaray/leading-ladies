{%- style -%}
  #LwlEventDetails-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #ed3a31;
    text-align: center;
  }

  /* crumpled paper: a seamless texture in the section's own red (theme asset), in place of the flat colour */
  #LwlEventDetails-{{ section.id }}.lwl-details--paper {
    background-color: #ed3a31;
    background-image: url('{{ 'lwl-crumpled-paper-red.jpg' | asset_url }}');
    background-size: 1100px 1100px;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #ffffff;
    margin: 0 0 4rem;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__grid {
    max-width: 110rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: 2.4rem;
  }

  /* --f is the "focused" amount: 0 at rest, 1 on hover / keyboard focus / tap */
  #LwlEventDetails-{{ section.id }} .lwl-details__card {
    --f: 0;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 30rem;
    border-radius: 1.6rem;
    background-color: #8f1f19;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.2);
    cursor: pointer;
    outline: none;
    opacity: 0;
    transform: translateY(3rem) scale(0.96);
    transition: opacity 0.7s ease, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__card.is-visible {
    opacity: 1;
    transform: translateY(calc(var(--f) * -0.6rem));
    box-shadow: 0 calc(1rem + var(--f) * 0.8rem) calc(2.5rem + var(--f) * 1.5rem) rgba(0, 0, 0, calc(0.2 + var(--f) * 0.15));
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__card.is-active,
  #LwlEventDetails-{{ section.id }} .lwl-details__card:focus-visible {
    --f: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    #LwlEventDetails-{{ section.id }} .lwl-details__card:hover {
      --f: 1;
    }
  }

  /* display: block overrides the theme's `div:empty { display: none }` reset */
  #LwlEventDetails-{{ section.id }} .lwl-details__bg {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    transform: scale(calc(1 + var(--f) * 0.1));
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* light wash at rest: the photo stays apparent, the bottom is darker for the text */
  #LwlEventDetails-{{ section.id }} .lwl-details__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(237, 58, 49, 0.06) 0%, rgba(140, 24, 18, 0.12) 36%, rgba(110, 18, 14, 0.8) 62%, rgba(95, 14, 10, 0.93) 100%);
  }

  /* strong red wash that fades in on hover / focus / tap */
  #LwlEventDetails-{{ section.id }} .lwl-details__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(237, 58, 49, 0.84) 0%, rgba(237, 58, 49, 0.94) 100%);
    opacity: var(--f);
    transition: opacity 0.5s ease;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: 2.4rem 2rem 2.8rem;
    transform: translateY(calc(var(--f) * -0.4rem));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__label {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    color: #fcc0c5;
    margin: 0 0 0.8rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__value {
    font-size: 2.1rem;
    line-height: 1.35;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  @media screen and (max-width: 749px) {
    #LwlEventDetails-{{ section.id }} .lwl-details__card {
      min-height: 24rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlEventDetails-{{ section.id }} .lwl-details__card,
    #LwlEventDetails-{{ section.id }} .lwl-details__bg,
    #LwlEventDetails-{{ section.id }} .lwl-details__card::after,
    #LwlEventDetails-{{ section.id }} .lwl-details__content {
      transition: none;
    }

    #LwlEventDetails-{{ section.id }} .lwl-details__card {
      opacity: 1;
      transform: none;
    }
  }
{%- endstyle -%}

<div id="LwlEventDetails-{{ section.id }}" class="lwl-details{% if section.settings.paper_texture %} lwl-details--paper{% endif %}">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-details__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-details__grid">
    {%- for block in section.blocks -%}
      <div class="lwl-details__card" data-lwl-reveal tabindex="0" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="lwl-details__bg" style="background-image: url('{{ block.settings.image | image_url: width: 900 }}');"></div>
        {%- endif -%}
        <div class="lwl-details__content">
          {%- if block.settings.label != blank -%}
            <h3 class="lwl-details__label">{{ block.settings.label | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.value != blank -%}
            <p class="lwl-details__value">{{ block.settings.value | escape | replace: ' | ', '<br>' }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('LwlEventDetails-{{ section.id }}');
    if (!root) return;
    var cards = root.querySelectorAll('[data-lwl-reveal]');
    if (!cards.length) return;

    if (!('IntersectionObserver' in window)) {
      cards.forEach(function (c) { c.classList.add('is-visible'); });
    } else {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry, i) {
          if (entry.isIntersecting) {
            setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 110);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      cards.forEach(function (c) { observer.observe(c); });
    }

    // tap / click toggles the focused look (touch screens have no hover)
    cards.forEach(function (card) {
      card.addEventListener('click', function () {
        var wasActive = card.classList.contains('is-active');
        cards.forEach(function (c) { c.classList.remove('is-active'); });
        if (!wasActive) card.classList.add('is-active');
      });
    });
    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) {
        cards.forEach(function (c) { c.classList.remove('is-active'); });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "LWL Event Details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "checkbox", "id": "paper_texture", "label": "Crumpled paper background", "info": "Replaces the flat red with a crumpled paper texture.", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Event Details" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value", "info": "Use \" | \" to start a new line." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Event Details",
      "blocks": [
        { "type": "detail", "settings": { "label": "Date", "value": "November 14, 2026 | Saturday" } },
        { "type": "detail", "settings": { "label": "Time", "value": "10:00 AM – 4:00 PM" } },
        { "type": "detail", "settings": { "label": "Location", "value": "Greyhound Café, Ayala Triangle Gardens, Makati City" } },
        { "type": "detail", "settings": { "label": "Ticket Price", "value": "₱4,999" } }
      ]
    }
  ]
}
{% endschema %}
