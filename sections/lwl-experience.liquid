{%- style -%}
  #LwlExperience-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #fcc0c5;
    text-align: center;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__heading {
    color: #ffffff;
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    margin: 0 0 4rem;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__grid {
    max-width: 100rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 0;
    text-align: left;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    border-left: 1px solid rgba(255, 255, 255, 0.4);
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item {
    position: relative;
    padding: 3.2rem 2.8rem;
    border-right: 1px solid rgba(255, 255, 255, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    opacity: 0;
    transform: translateY(1.6rem);
    transition: opacity 0.5s ease, transform 0.5s ease, background-color 0.3s ease;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #LwlExperience-{{ section.id }} .lwl-experience__item:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  #LwlExperience-{{ section.id }} .lwl-experience__number {
    display: block;
    font-size: 4.4rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1.6rem;
  }

  #LwlExperience-{{ section.id }} .lwl-experience__label {
    color: #ffffff;
    font-size: 1.9rem;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlExperience-{{ section.id }} .lwl-experience__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlExperience-{{ section.id }}" class="lwl-experience">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-experience__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-experience__grid">
    {%- for block in section.blocks -%}
      <div class="lwl-experience__item" data-lwl-reveal {{ block.shopify_attributes }}>
        <span class="lwl-experience__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <p class="lwl-experience__label">{{ block.settings.label | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var items = document.querySelectorAll('#LwlExperience-{{ section.id }} [data-lwl-reveal]');
    if (!items.length) return;
    if (!('IntersectionObserver' in window)) {
      items.forEach(function (c) { c.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    items.forEach(function (c) { observer.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "LWL Experience",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What To Expect" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Experience",
      "blocks": [
        { "type": "item", "settings": { "label": "Networking Sessions" } },
        { "type": "item", "settings": { "label": "Founder Conversations" } },
        { "type": "item", "settings": { "label": "Leadership Panels" } },
        { "type": "item", "settings": { "label": "Collaboration Opportunities" } },
        { "type": "item", "settings": { "label": "Community Building" } },
        { "type": "item", "settings": { "label": "Inspiring Stories" } }
      ]
    }
  ]
}
{% endschema %}
