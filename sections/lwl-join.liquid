{%- style -%}
  #LwlJoin-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: 7rem 2rem;
    background: #121212;
    color: #ffffff;
    text-align: center;
  }

  #LwlJoin-{{ section.id }} .lwl-join__glow {
    position: absolute;
    width: 40rem;
    height: 40rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(252, 192, 197, 0.35) 0%, rgba(252, 192, 197, 0) 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: lwl-pulse 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes lwl-pulse {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.25);
      opacity: 1;
    }
  }

  #LwlJoin-{{ section.id }} .lwl-join__inner {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
  }

  #LwlJoin-{{ section.id }} .lwl-join__heading {
    font-size: clamp(3.2rem, 6vw, 5.6rem);
    margin: 0 0 1rem;
    background: linear-gradient(90deg, #fcc0c5, #ffffff, #fcc0c5);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: lwl-gradient-text 4s linear infinite;
  }

  @keyframes lwl-gradient-text {
    to {
      background-position: 200% center;
    }
  }

  #LwlJoin-{{ section.id }} .lwl-join__underline {
    width: 8rem;
    height: 0.4rem;
    background: #fcc0c5;
    border-radius: 999px;
    margin: 0 auto 3rem;
  }

  #LwlJoin-{{ section.id }} .lwl-join__body {
    font-size: 1.7rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 4rem;
  }

  #LwlJoin-{{ section.id }} .lwl-join__body p {
    margin: 0 0 1.6rem;
  }

  #LwlJoin-{{ section.id }} .lwl-join__body p:last-child {
    margin-bottom: 0;
  }

  #LwlJoin-{{ section.id }} .lwl-join__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: #fcc0c5;
    color: #121212;
    font-weight: 700;
    font-size: 1.7rem;
    padding: 1.5rem 3.6rem;
    border-radius: 999px;
    text-decoration: none;
    overflow: hidden;
    z-index: 1;
    transition: color 0.35s ease, transform 0.25s ease;
  }

  #LwlJoin-{{ section.id }} .lwl-join__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #ed3a31;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: -1;
  }

  #LwlJoin-{{ section.id }} .lwl-join__cta:hover {
    color: #ffffff;
    transform: translateY(-0.3rem);
  }

  #LwlJoin-{{ section.id }} .lwl-join__cta:hover::before {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlJoin-{{ section.id }} .lwl-join__glow,
    #LwlJoin-{{ section.id }} .lwl-join__heading {
      animation: none !important;
    }
  }
{%- endstyle -%}

<div id="LwlJoin-{{ section.id }}" class="lwl-join">
  <div class="lwl-join__glow"></div>
  <div class="lwl-join__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lwl-join__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="lwl-join__underline"></div>
    {%- if section.settings.body != blank -%}
      <div class="lwl-join__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="lwl-join__cta">
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LWL Join",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Movement For Women Who Lead"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join Ladies Who Launch"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "LWL Join"
    }
  ]
}
{% endschema %}
