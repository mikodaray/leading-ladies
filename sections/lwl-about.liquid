{%- style -%}
  #LwlAbout-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #ffffff;
  }

  #LwlAbout-{{ section.id }} .lwl-about__inner {
    max-width: 110rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  #LwlAbout-{{ section.id }} .lwl-about__images {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
  }

  #LwlAbout-{{ section.id }} .lwl-about__image {
    border-radius: 1.6rem;
    overflow: hidden;
    box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.15);
  }

  #LwlAbout-{{ section.id }} .lwl-about__image--offset {
    transform: translateY(3rem);
  }

  #LwlAbout-{{ section.id }} .lwl-about__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #LwlAbout-{{ section.id }} .lwl-about__image:hover img {
    transform: scale(1.06);
  }

  #LwlAbout-{{ section.id }} .lwl-about__content {
    opacity: 0;
    transform: translateX(2.4rem);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  #LwlAbout-{{ section.id }} .lwl-about__content.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  #LwlAbout-{{ section.id }} .lwl-about__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #121212;
    margin: 0 0 1.6rem;
  }

  #LwlAbout-{{ section.id }} .lwl-about__copy {
    font-size: 1.6rem;
    line-height: 1.75;
    color: rgba(18, 18, 18, 0.75);
  }

  #LwlAbout-{{ section.id }} .lwl-about__copy p {
    margin: 0 0 1.4rem;
  }

  #LwlAbout-{{ section.id }} .lwl-about__copy p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 900px) {
    #LwlAbout-{{ section.id }} .lwl-about__inner {
      grid-template-columns: 1fr;
    }
    #LwlAbout-{{ section.id }} .lwl-about__image--offset {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlAbout-{{ section.id }} .lwl-about__content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlAbout-{{ section.id }}" class="lwl-about">
  <div class="lwl-about__inner">
    <div class="lwl-about__images">
      {%- if section.settings.image_1 != blank -%}
        <div class="lwl-about__image">
          <img
            src="{{ section.settings.image_1 | image_url: width: 700 }}"
            srcset="{{ section.settings.image_1 | image_url: width: 500 }} 500w, {{ section.settings.image_1 | image_url: width: 700 }} 700w"
            sizes="(min-width: 750px) 25vw, 45vw"
            alt="{{ section.settings.image_1.alt | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        <div class="lwl-about__image lwl-about__image--offset">
          <img
            src="{{ section.settings.image_2 | image_url: width: 700 }}"
            srcset="{{ section.settings.image_2 | image_url: width: 500 }} 500w, {{ section.settings.image_2 | image_url: width: 700 }} 700w"
            sizes="(min-width: 750px) 25vw, 45vw"
            alt="{{ section.settings.image_2.alt | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>
    <div class="lwl-about__content" data-lwl-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="lwl-about__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.copy != blank -%}
        <div class="lwl-about__copy">{{ section.settings.copy }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var el = document.querySelector('#LwlAbout-{{ section.id }} [data-lwl-reveal]');
    if (!el) return;
    if (!('IntersectionObserver' in window)) {
      el.classList.add('is-visible');
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    observer.observe(el);
  })();
</script>

{% schema %}
{
  "name": "LWL About",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Community Built By Women, For Women" },
    { "type": "richtext", "id": "copy", "label": "Copy" }
  ],
  "presets": [
    { "name": "LWL About" }
  ]
}
{% endschema %}
