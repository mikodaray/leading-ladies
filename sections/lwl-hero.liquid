{%- style -%}
  #LwlHero-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    position: relative;
    overflow: hidden;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10rem 2rem 6rem;
    text-align: center;
    color: #ffffff;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.3rem;
    will-change: transform;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item {
    position: relative;
    overflow: hidden;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item:nth-child(1) {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item:nth-child(2) {
    grid-column: 3 / 5;
    grid-row: 1 / 2;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item:nth-child(3) {
    grid-column: 3 / 4;
    grid-row: 2 / 3;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item:nth-child(4) {
    grid-column: 4 / 5;
    grid-row: 2 / 3;
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
    transition: transform 6s ease;
  }

  #LwlHero-{{ section.id }}:hover .lwl-hero__mosaic-item img {
    transform: scale(1);
  }

  #LwlHero-{{ section.id }} .lwl-hero__mosaic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.35) 0%, rgba(18, 18, 18, 0.15) 50%, rgba(18, 18, 18, 0.5) 100%);
  }

  #LwlHero-{{ section.id }} .lwl-hero__card {
    position: relative;
    z-index: 1;
    background-color: rgba(237, 58, 49, 0.88);
    border-radius: 2.4rem;
    padding: 4.4rem 4rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.35);
  }

  #LwlHero-{{ section.id }} .lwl-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: 0 auto;
  }

  #LwlHero-{{ section.id }} .lwl-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.3rem;
    text-transform: uppercase;
    padding: 0.6rem 1.8rem;
    border: 1.5px dashed rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    margin-bottom: 2.4rem;
    box-shadow: 0 0 0 4px rgba(252, 192, 197, 0.25);
    opacity: 0;
    animation: lwl-fade-up 0.8s ease forwards 0.1s, lwl-eyebrow-glow 2.5s ease-in-out infinite 1s;
  }

  @keyframes lwl-eyebrow-glow {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgba(252, 192, 197, 0.25);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(252, 192, 197, 0.4);
    }
  }

  #LwlHero-{{ section.id }} .lwl-hero__heading {
    font-size: clamp(3.4rem, 7vw, 6.4rem);
    line-height: 1;
    margin: 0 0 1.4rem;
    opacity: 0;
    animation: lwl-fade-up 0.8s ease forwards 0.25s;
  }

  #LwlHero-{{ section.id }} .lwl-hero__heading--logo {
    max-width: 24rem;
    margin-left: auto;
    margin-right: auto;
  }

  #LwlHero-{{ section.id }} .lwl-hero__heading--logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  #LwlHero-{{ section.id }} .lwl-hero__subheading {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    margin: 0 0 2.4rem;
    opacity: 0;
    animation: lwl-fade-up 0.8s ease forwards 0.4s;
  }

  #LwlHero-{{ section.id }} .lwl-hero__copy {
    font-size: 1.6rem;
    line-height: 1.7;
    max-width: 62rem;
    margin: 0 auto 3.2rem;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    animation: lwl-fade-up 0.8s ease forwards 0.5s;
  }

  #LwlHero-{{ section.id }} .lwl-hero__copy p {
    margin: 0 0 1.2rem;
  }

  #LwlHero-{{ section.id }} .lwl-hero__copy p:last-child {
    margin-bottom: 0;
  }

  @keyframes lwl-fade-up {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #LwlHero-{{ section.id }} .lwl-hero__countdown {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 3.2rem;
    opacity: 0;
    animation: lwl-fade-up 0.9s ease forwards 0.65s;
  }

  #LwlHero-{{ section.id }} .lwl-hero__countdown-unit {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 1.2rem;
    padding: 1.2rem 1.4rem;
    min-width: 8rem;
  }

  #LwlHero-{{ section.id }} .lwl-hero__countdown-value {
    display: block;
    font-size: 3.2rem;
    line-height: 1;
  }

  #LwlHero-{{ section.id }} .lwl-hero__countdown-label {
    display: block;
    font-size: 1.1rem;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    margin-top: 0.4rem;
    opacity: 0.8;
  }

  #LwlHero-{{ section.id }} .lwl-hero__actions {
    display: flex;
    justify-content: center;
    gap: 1.6rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: lwl-fade-up 0.9s ease forwards 0.8s;
  }

  #LwlHero-{{ section.id }} .lwl-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 700;
    padding: 1.4rem 3.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1.6rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #LwlHero-{{ section.id }} .lwl-hero__cta--primary {
    background: #ffffff;
    color: #ed3a31;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.25);
  }

  #LwlHero-{{ section.id }} .lwl-hero__cta--secondary {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
  }

  #LwlHero-{{ section.id }} .lwl-hero__cta:hover {
    transform: translateY(-0.3rem);
  }

  #LwlHero-{{ section.id }} .lwl-hero__cta--primary:hover {
    box-shadow: 0 1.4rem 3rem rgba(0, 0, 0, 0.3);
  }

  @media screen and (max-width: 749px) {
    #LwlHero-{{ section.id }} .lwl-hero__card {
      padding: 2.8rem 2rem;
      border-radius: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlHero-{{ section.id }} * {
      animation: none !important;
      transition: none !important;
    }
  }
{%- endstyle -%}

<div id="LwlHero-{{ section.id }}" class="lwl-hero">
  <div class="lwl-hero__mosaic" data-lwl-parallax>
    {%- for block in section.blocks -%}
      {%- if block.type == 'mosaic_image' and block.settings.image != blank -%}
        <div class="lwl-hero__mosaic-item">
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
            sizes="50vw"
            alt=""
            loading="eager"
          >
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="lwl-hero__inner">
   <div class="lwl-hero__card">
    {%- if section.settings.eyebrow != blank -%}
      <span class="lwl-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.logo_image != blank -%}
      <h1 class="lwl-hero__heading lwl-hero__heading--logo">
        <img
          src="{{ section.settings.logo_image | image_url: width: 480 }}"
          srcset="{{ section.settings.logo_image | image_url: width: 320 }} 320w, {{ section.settings.logo_image | image_url: width: 480 }} 480w"
          sizes="(min-width: 750px) 24rem, 60vw"
          alt="{{ section.settings.heading | default: 'Ladies Who Launch' | escape }}"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
        >
      </h1>
    {%- elsif section.settings.heading != blank -%}
      <h1 class="lwl-hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="lwl-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.copy != blank -%}
      <div class="lwl-hero__copy">{{ section.settings.copy }}</div>
    {%- endif -%}

    {%- if section.settings.event_datetime != blank -%}
      <div class="lwl-hero__countdown" data-lwl-countdown="{{ section.settings.event_datetime }}">
        <div class="lwl-hero__countdown-unit">
          <span class="lwl-hero__countdown-value" data-lwl-days>00</span>
          <span class="lwl-hero__countdown-label">Days</span>
        </div>
        <div class="lwl-hero__countdown-unit">
          <span class="lwl-hero__countdown-value" data-lwl-hours>00</span>
          <span class="lwl-hero__countdown-label">Hours</span>
        </div>
        <div class="lwl-hero__countdown-unit">
          <span class="lwl-hero__countdown-value" data-lwl-minutes>00</span>
          <span class="lwl-hero__countdown-label">Minutes</span>
        </div>
        <div class="lwl-hero__countdown-unit">
          <span class="lwl-hero__countdown-value" data-lwl-seconds>00</span>
          <span class="lwl-hero__countdown-label">Seconds</span>
        </div>
      </div>
    {%- endif -%}

    <div class="lwl-hero__actions">
      {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
        <a href="{{ section.settings.primary_link }}" class="lwl-hero__cta lwl-hero__cta--primary">
          {{ section.settings.primary_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="lwl-hero__cta lwl-hero__cta--secondary">
          {{ section.settings.secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>
   </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('LwlHero-{{ section.id }}');
    if (!section) return;

    var countdown = section.querySelector('[data-lwl-countdown]');
    if (countdown) {
      var target = new Date(countdown.dataset.lwlCountdown).getTime();
      var daysEl = countdown.querySelector('[data-lwl-days]');
      var hoursEl = countdown.querySelector('[data-lwl-hours]');
      var minutesEl = countdown.querySelector('[data-lwl-minutes]');
      var secondsEl = countdown.querySelector('[data-lwl-seconds]');

      function pad(num) {
        return String(num).padStart(2, '0');
      }

      function tick() {
        var diff = target - Date.now();
        if (isNaN(target) || diff <= 0) {
          daysEl.textContent = hoursEl.textContent = minutesEl.textContent = secondsEl.textContent = '00';
          return;
        }
        daysEl.textContent = pad(Math.floor(diff / (1000 * 60 * 60 * 24)));
        hoursEl.textContent = pad(Math.floor((diff / (1000 * 60 * 60)) % 24));
        minutesEl.textContent = pad(Math.floor((diff / (1000 * 60)) % 60));
        secondsEl.textContent = pad(Math.floor((diff / 1000) % 60));
      }

      tick();
      setInterval(tick, 1000);
    }

    var mosaic = section.querySelector('[data-lwl-parallax]');
    if (mosaic && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          var rect = section.getBoundingClientRect();
          var offset = rect.top * -0.08;
          offset = Math.max(-40, Math.min(40, offset));
          mosaic.style.transform = 'translateY(' + offset + 'px)';
          ticking = false;
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "LWL Hero",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "4 Years of Connecting Women Who Lead"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (used as image alt text if a logo image is set)",
      "default": "Ladies Who Launch: Season 4"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (replaces the text heading if set)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where ambitious women connect, collaborate, and thrive."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Hero copy"
    },
    {
      "type": "text",
      "id": "event_datetime",
      "label": "Event date & time (for countdown)",
      "info": "Use a format like 2026-11-14T10:00:00+08:00",
      "default": "2026-11-14T10:00:00+08:00"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Reserve Your Spot"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "mosaic_image",
      "name": "Mosaic image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Hero"
    }
  ]
}
{% endschema %}
