{%- style -%}
  #LwlTimeline-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #ffffff;
    text-align: center;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #ed3a31;
    margin: 0 0 1.6rem;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__copy {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(18, 18, 18, 0.75);
    margin-bottom: 5rem;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__copy p {
    margin: 0 0 1.2rem;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__list {
    position: relative;
    text-align: left;
    max-width: 50rem;
    margin: 0 auto;
    padding-left: 3rem;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__list::before {
    content: '';
    position: absolute;
    left: 0.7rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: rgba(237, 58, 49, 0.2);
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__step {
    position: relative;
    padding-bottom: 3.2rem;
    opacity: 0;
    transform: translateX(-1.6rem);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__step.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__step:last-child {
    padding-bottom: 0;
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__dot {
    position: absolute;
    left: -3rem;
    top: 0.2rem;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: #ed3a31;
    box-shadow: 0 0 0 4px rgba(237, 58, 49, 0.15);
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__step:last-child .lwl-timeline__dot {
    background: #fcc0c5;
    box-shadow: 0 0 0 4px rgba(252, 192, 197, 0.3);
  }

  #LwlTimeline-{{ section.id }} .lwl-timeline__label {
    font-size: 2rem;
    color: #121212;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlTimeline-{{ section.id }} .lwl-timeline__step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlTimeline-{{ section.id }}" class="lwl-timeline">
  <div class="lwl-timeline__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lwl-timeline__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.copy != blank -%}
      <div class="lwl-timeline__copy">{{ section.settings.copy }}</div>
    {%- endif -%}
    <div class="lwl-timeline__list">
      {%- for block in section.blocks -%}
        <div class="lwl-timeline__step" data-lwl-reveal {{ block.shopify_attributes }}>
          <span class="lwl-timeline__dot"></span>
          <h3 class="lwl-timeline__label">{{ block.settings.label | escape }}</h3>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var steps = document.querySelectorAll('#LwlTimeline-{{ section.id }} [data-lwl-reveal]');
    if (!steps.length) return;
    if (!('IntersectionObserver' in window)) {
      steps.forEach(function (s) { s.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 120);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    steps.forEach(function (s) { observer.observe(s); });
  })();
</script>

{% schema %}
{
  "name": "LWL Timeline",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four Years of Connecting Women Who Lead" },
    { "type": "richtext", "id": "copy", "label": "Copy" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Timeline",
      "blocks": [
        { "type": "step", "settings": { "label": "Year 1: Building Connections" } },
        { "type": "step", "settings": { "label": "Year 2: Growing Community" } },
        { "type": "step", "settings": { "label": "Year 3: Expanding Impact" } },
        { "type": "step", "settings": { "label": "Year 4: Stronger Than Ever" } },
        { "type": "step", "settings": { "label": "Today: Ladies Who Launch Season 4" } }
      ]
    }
  ]
}
{% endschema %}
