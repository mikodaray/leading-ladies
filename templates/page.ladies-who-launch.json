    "lwl_story": {
      "type": "lwl-story",
      "blocks": {
        "photo_1": { "type": "photo", "settings": { "image": "shopify://shop_images/eventpics-3.jpg" } },
        "photo_2": { "type": "photo", "settings": { "image": "shopify://shop_images/eventpics-6.jpg" } },
        "photo_3": { "type": "photo", "settings": { "image": "shopify://shop_images/eventpics-7.jpg" } },
        "photo_4": { "type": "photo", "settings": { "image": "shopify://shop_images/eventpics-9.jpg" } },
        "photo_5": { "type": "photo", "settings": { "image": "shopify://shop_images/eventpics-11.jpg" } },
