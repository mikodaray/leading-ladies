{%- style -%}
  #LwlWhyJoin-{{ section.id }} {
    padding: 6rem 2rem;
    background: #fff5f5;
    text-align: center;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #ed3a31;
    margin: 0 0 4rem;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__grid {
    max-width: 110rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: 2.4rem;
    text-align: left;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__card {
    background: #ffffff;
    border-radius: 1.6rem;
    padding: 3.2rem 2.6rem;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.06);
    opacity: 0;
    transform: translateY(2.4rem);
    transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.3s ease;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__card.is-visible:hover {
    box-shadow: 0 1.6rem 3.5rem rgba(237, 58, 49, 0.15);
    transform: translateY(-0.6rem) scale(1.02);
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__icon {
    font-size: 3.2rem;
    display: block;
    margin-bottom: 1.6rem;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__title {
    font-size: 2.1rem;
    margin: 0 0 0.8rem;
    color: #121212;
  }

  #LwlWhyJoin-{{ section.id }} .lwl-why__text {
    font-size: 1.5rem;
    color: rgba(18, 18, 18, 0.7);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlWhyJoin-{{ section.id }} .lwl-why__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlWhyJoin-{{ section.id }}" class="lwl-why">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-why__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-why__grid">
    {%- for block in section.blocks -%}
      <div class="lwl-why__card" data-lwl-reveal {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="lwl-why__icon" aria-hidden="true">{{ block.settings.icon }}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="lwl-why__title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="lwl-why__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var cards = document.querySelectorAll('#LwlWhyJoin-{{ section.id }} [data-lwl-reveal]');
    if (!cards.length) return;
    if (!('IntersectionObserver' in window)) {
      cards.forEach(function (c) { c.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 90);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    cards.forEach(function (c) { observer.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "LWL Why Join",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Join Ladies Who Launch Season 4?" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✨" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Why Join",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🤝", "title": "Meaningful Connections", "text": "Meet women who share your ambition and vision." } },
        { "type": "feature", "settings": { "icon": "💬", "title": "Inspiring Conversations", "text": "Learn from founders, entrepreneurs, and leaders." } },
        { "type": "feature", "settings": { "icon": "🫶", "title": "Community Support", "text": "Find encouragement, accountability, and connection." } },
        { "type": "feature", "settings": { "icon": "🚀", "title": "Collaboration Opportunities", "text": "Build partnerships and business relationships." } },
        { "type": "feature", "settings": { "icon": "📈", "title": "Leadership Growth", "text": "Gain fresh insights and new perspectives." } },
        { "type": "feature", "settings": { "icon": "💞", "title": "Lasting Relationships", "text": "Create connections that continue beyond the event." } }
      ]
    }
  ]
}
{% endschema %}
