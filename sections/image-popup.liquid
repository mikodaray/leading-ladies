{%- style -%}
  /* the popup and its button are fixed-position, so keep this wrapper from adding page spacing */
  #shopify-section-{{ section.id }} {
    margin: 0;
  }

  #ImagePopup-{{ section.id }} {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-color: rgba(237, 58, 49, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }

  #ImagePopup-{{ section.id }}.image-popup--visible {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
  }

  #ImagePopup-{{ section.id }} .image-popup__content {
    position: relative;
    max-width: {{ section.settings.max_width }}px;
    width: 100%;
    transform: scale(0.92) translateY(0.8rem);
    transition: transform 0.25s ease;
  }

  #ImagePopup-{{ section.id }}.image-popup--visible .image-popup__content {
    transform: scale(1) translateY(0);
  }

  #ImagePopup-{{ section.id }} .image-popup__link {
    display: block;
    line-height: 0;
  }

  #ImagePopup-{{ section.id }} .image-popup__image {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    border-radius: {{ section.settings.corner_radius }}px;
    display: block;
    animation: image-popup-bob 3s ease-in-out infinite;
  }

  @keyframes image-popup-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.6rem);
    }
  }

  #ImagePopup-{{ section.id }} .image-popup__close {
    position: absolute;
    top: -1.6rem;
    right: -1.6rem;
    z-index: 2;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background-color: #fcc0c5;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem;
  }

  #ImagePopup-{{ section.id }} .image-popup__close svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    #ImagePopup-{{ section.id }} .image-popup__close {
      top: -1.2rem;
      right: 0;
    }
  }

  /* luggage-tag button: hangs off the lower right of the popup image */
  #ImagePopup-{{ section.id }} .image-popup__tag {
    position: absolute;
    right: -2rem;
    bottom: 6.4rem;
    z-index: 2;
    display: block;
    width: 9.2rem;
    line-height: 0;
    -webkit-tap-highlight-color: transparent;
    transition: scale 0.25s ease;
  }

  #ImagePopup-{{ section.id }} .image-popup__tag:hover,
  #ImagePopup-{{ section.id }} .image-popup__tag:focus-visible {
    scale: 1.08;
  }

  #ImagePopup-{{ section.id }} .image-popup__tag-img {
    display: block;
    width: 100%;
    aspect-ratio: 504 / 972;
    object-fit: cover;
    transform-origin: 50% 6%;
    filter: drop-shadow(0 0.6rem 0.9rem rgba(0, 0, 0, 0.35));
    animation: image-popup-tag-wobble 3s ease-in-out infinite;
  }

  /* hanging-tag wobble: a quick damped swing, then a short rest */
  @keyframes image-popup-tag-wobble {
    0% {
      transform: rotate(0deg);
    }
    8% {
      transform: rotate(-12deg);
    }
    16% {
      transform: rotate(10deg);
    }
    24% {
      transform: rotate(-7deg);
    }
    32% {
      transform: rotate(5deg);
    }
    40% {
      transform: rotate(-2deg);
    }
    48%,
    100% {
      transform: rotate(0deg);
    }
  }

  /* on click: wind up, pop, then burst away; the page only opens once this has played */
  #ImagePopup-{{ section.id }} .image-popup__tag.is-clicked .image-popup__tag-img {
    animation: image-popup-tag-click 0.9s cubic-bezier(0.3, 0.7, 0.3, 1) forwards;
  }

  @keyframes image-popup-tag-click {
    0% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
    22% {
      transform: rotate(-14deg) scale(0.86);
    }
    55% {
      transform: rotate(14deg) scale(1.3);
    }
    78% {
      transform: rotate(-6deg) scale(1.18);
      opacity: 1;
    }
    100% {
      transform: rotate(0deg) scale(1.7);
      opacity: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #ImagePopup-{{ section.id }} .image-popup__tag {
      right: -1.2rem;
      bottom: 5rem;
      width: 7.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ImagePopup-{{ section.id }} .image-popup__tag,
    #ImagePopup-{{ section.id }} .image-popup__tag-img {
      animation: none;
      transition: none;
    }
  }

  #ImagePopupTrigger-{{ section.id }} {
    position: fixed;
    left: 0;
    bottom: 2rem;
    z-index: 99999;
    background-color: #fcc0c5;
    color: #ffffff;
    border: none;
    padding: 1.2rem 2rem 1.2rem 1.6rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.06rem;
    border-radius: 0 999px 999px 0;
    cursor: pointer;
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.2);
  }

  #ImagePopupTrigger-{{ section.id }}.image-popup__trigger--logo {
    display: flex;
    align-items: center;
    padding: 0.4rem 1.8rem 0.4rem 0.8rem;
  }

  #ImagePopupTrigger-{{ section.id }} .image-popup__trigger-logo {
    display: block;
    width: 6.4rem;
    height: 6.4rem;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    #ImagePopupTrigger-{{ section.id }} .image-popup__trigger-logo {
      width: 5.2rem;
      height: 5.2rem;
    }
  }
{%- endstyle -%}

{%- assign popup_here = true -%}
{%- if section.settings.only_on_product != blank and product.handle != section.settings.only_on_product -%}
  {%- assign popup_here = false -%}
{%- endif -%}

{%- if section.settings.image != blank and popup_here -%}
  <div
    id="ImagePopup-{{ section.id }}"
    class="image-popup"
    data-image-popup
    data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
    data-remember-close="{{ section.settings.remember_close }}"
    data-force-open-param="{{ section.settings.force_open_param | escape }}"
    data-hide-param="{{ section.settings.hide_param | escape }}"
  >
    <div class="image-popup__content">
      <button
        type="button"
        class="image-popup__close"
        data-image-popup-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <svg viewBox="0 0 18 17" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path
            d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.707-.707L9.712 8.547l7.433-7.431a.5.5 0 00-.707-.707L8.858 7.986 1.278.704a.5.5 0 10-.707.707l7.712 7.421-7.418 7.146z"
            fill="currentColor"
            fill-rule="evenodd"
          />
        </svg>
      </button>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="image-popup__link">
      {%- endif -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 750px) {{ section.settings.max_width }}px, 90vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="image-popup__image"
            loading="eager"
          >
      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}
      {%- if section.settings.tag_image != blank and section.settings.link != blank -%}
        <a
          href="{{ section.settings.link }}"
          class="image-popup__tag"
          data-image-popup-tag
          aria-label="Open the Ladies Who Launch page"
        >
          <img
            src="{{ section.settings.tag_image | image_url: width: 500 }}"
            alt=""
            class="image-popup__tag-img"
            loading="eager"
          >
        </a>
      {%- endif -%}
    </div>
  </div>

  <button
    type="button"
    id="ImagePopupTrigger-{{ section.id }}"
    class="image-popup__trigger{% if section.settings.trigger_image != blank %} image-popup__trigger--logo{% endif %}"
    aria-label="Show promotion"
  >
    {%- if section.settings.trigger_image != blank -%}
      <img
        src="{{ section.settings.trigger_image | image_url: width: 300 }}"
        alt=""
        width="64"
        height="64"
        class="image-popup__trigger-logo"
        loading="eager"
      >
    {%- else -%}
      Ladies Who Launch S4!
    {%- endif -%}
  </button>

  <script>
    (function () {
      var popup = document.getElementById('ImagePopup-{{ section.id }}');
      var trigger = document.getElementById('ImagePopupTrigger-{{ section.id }}');
      if (!popup) return;

      var delay = parseInt(popup.dataset.delay, 10) || 0;

      function showPopup() {
        popup.classList.add('image-popup--visible');
      }

      function hidePopup() {
        popup.classList.remove('image-popup--visible');
      }

      // Optionally remember, per page, that the popup was closed so it stops
      // auto-opening there. The trigger button keeps working either way.
      var rememberClose = popup.dataset.rememberClose === 'true';
      var closedKey = 'imagePopupClosed:' + window.location.pathname;

      function wasClosedBefore() {
        if (!rememberClose) return false;
        try {
          return window.localStorage.getItem(closedKey) === '1';
        } catch (e) {
          return false;
        }
      }

      function rememberClosed() {
        if (!rememberClose) return;
        try {
          window.localStorage.setItem(closedKey, '1');
        } catch (e) {}
      }

      // Optional URL parameters (names are set in the section settings):
      //   <hide param>=true        never auto-open; only the trigger button shows
      //   <force-open param>=true  open it even if it was closed before
      // With neither, it auto-opens as usual (unless it was closed before and
      // "remember close" is on). The hide parameter wins if both are present.
      var forceOpenParam = popup.dataset.forceOpenParam || '';
      var hideParam = popup.dataset.hideParam || '';

      function paramIsTrue(name) {
        if (!name) return false;
        try {
          return (new URLSearchParams(window.location.search).get(name) || '').toLowerCase() === 'true';
        } catch (e) {
          return false;
        }
      }

      function autoShow() {
        if (paramIsTrue(hideParam)) return;
        if (!paramIsTrue(forceOpenParam) && wasClosedBefore()) return;
        window.setTimeout(showPopup, delay);
      }

      popup.querySelectorAll('[data-image-popup-close]').forEach(function (el) {
        el.addEventListener('click', function () {
          hidePopup();
          rememberClosed();
        });
      });

      if (trigger) {
        trigger.addEventListener('click', showPopup);
      }

      // The tag plays its click animation first, then opens the page.
      var tag = popup.querySelector('[data-image-popup-tag]');
      var tagClicked = false;

      function resetTag() {
        tagClicked = false;
        if (tag) tag.classList.remove('is-clicked');
      }

      if (tag) {
        tag.addEventListener('click', function (event) {
          // let new-tab / modified clicks behave like a normal link
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          event.preventDefault();
          if (tagClicked) return;
          tagClicked = true;
          tag.classList.add('is-clicked');

          var opened = false;
          function openPage() {
            if (opened) return;
            opened = true;
            window.location.href = tag.href;
          }

          var img = tag.querySelector('.image-popup__tag-img');
          if (img) img.addEventListener('animationend', openPage, { once: true });
          window.setTimeout(openPage, 1100); // safety net if animationend never fires
        });
      }

      autoShow();

      // Browsers can restore this page from bfcache (e.g. hitting back) without
      // re-running the script above, which would otherwise leave the popup
      // hidden after it was closed once. Re-trigger it on that kind of restore
      // so it reliably shows on every visit (unless it is set to stay closed).
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          hidePopup();
          resetTag();
          autoShow();
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Image popup",
  "tag": "section",
  "class": "section image-popup-section",
  "enabled_on": {
    "templates": ["index", "product"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link when image is clicked"
    },
    {
      "type": "image_picker",
      "id": "tag_image",
      "label": "Click-here tag image",
      "info": "Wobbling tag at the lower right of the popup. Opens the link above after its click animation."
    },
    {
      "type": "image_picker",
      "id": "trigger_image",
      "label": "Trigger button logo",
      "info": "Shown on the button that reopens the popup, instead of text."
    },
    {
      "type": "text",
      "id": "only_on_product",
      "label": "Only show on this product (handle)",
      "info": "For product pages: leave empty to show on every product, or enter a handle such as ladies-who-launch-season-4."
    },
    {
      "type": "text",
      "id": "force_open_param",
      "label": "URL parameter that opens the popup",
      "info": "For example lwlpopup: adding ?lwlpopup=true to the page address opens the popup, even if it was closed before."
    },
    {
      "type": "text",
      "id": "hide_param",
      "label": "URL parameter that keeps the popup closed",
      "info": "For example lwlpopuphide: ?lwlpopuphide=true stops it opening by itself. The button stays on screen. Wins over the parameter above."
    },
    {
      "type": "checkbox",
      "id": "remember_close",
      "label": "Don't auto-open again once it has been closed on this page",
      "info": "The button stays on screen so visitors can reopen the popup.",
      "default": false
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 1
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Image popup"
    }
  ]
}
{% endschema %}
