{%- style -%}
  /* the overlay is fixed-position, so keep this wrapper and its neighbour from adding page spacing */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} + .shopify-section {
    margin-top: 0;
  }

  /* hidden until the script decides to play (also keeps it off when JavaScript is unavailable).
     The id selector outranks the theme's `div:empty { display: none }` reset. */
  #LwlPaperIntro-{{ section.id }} {
    display: none;
  }

  #LwlPaperIntro-{{ section.id }}.lwl-paper--on {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 99998;
    overflow: hidden;
    contain: layout paint;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* display: block overrides the theme's `div:empty { display: none }` reset, which would hide this empty div */
  #LwlPaperIntro-{{ section.id }} .lwl-paper__backdrop {
    display: block;
    position: absolute;
    inset: 0;
    background: {{ section.settings.backdrop_color }};
  }

  #LwlPaperIntro-{{ section.id }} .lwl-paper__ball,
  #LwlPaperIntro-{{ section.id }} .lwl-paper__sheet {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: none;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    will-change: transform, opacity;
  }

  #LwlPaperIntro-{{ section.id }} .lwl-paper__ball {
    width: auto;
    height: clamp(170px, 32vh, 360px);
  }

  /* the torn sheet: sized by height on wide screens and by width on phones. The zoom aims at the middle of the tear. */
  #LwlPaperIntro-{{ section.id }} .lwl-paper__sheet {
    width: min(94vw, calc(92vh * 0.762));
    height: auto;
    transform-origin: 46% 51%;
  }
{%- endstyle -%}

{%- comment -%}
  Crumpled paper intro. A paper ball pops onto a coloured backdrop, rocks for a moment, then opens into a torn
  sheet through which the live page shows; the sheet zooms away to reveal the page. The artwork is a keyed
  (green-screen removed) ball and sheet, theme assets lwl-paper-ball.webp and lwl-paper-sheet.webp.
  Playing is decided by the script right below, before the rest of the page is parsed, so there is no flash
  of unveiled content.
{%- endcomment -%}
<link rel="preload" as="image" type="image/webp" href="{{ 'lwl-paper-ball.webp' | asset_url }}" fetchpriority="high">
<link rel="preload" as="image" type="image/webp" href="{{ 'lwl-paper-sheet.webp' | asset_url }}" fetchpriority="high">
<div
  id="LwlPaperIntro-{{ section.id }}"
  class="lwl-paper"
  aria-hidden="true"
  data-once="{{ section.settings.once_per_session }}"
  data-cover="{{ section.settings.cover_page }}"
></div>

<script>
  (function () {
    var root = document.getElementById('LwlPaperIntro-{{ section.id }}');
    if (!root) return;

    var KEY = 'lwlPaperIntro';
    var params;
    try { params = new URLSearchParams(window.location.search); } catch (e) { params = null; }
    var forced = !!params && params.get('lwlpaper') === '1'; // ?lwlpaper=1 replays it for previews

    var seen = false;
    try { seen = window.sessionStorage.getItem(KEY) === '1'; } catch (e) {}

    var skipIt =
      !root.animate ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ||
      (window.Shopify && window.Shopify.designMode) ||
      (root.dataset.once === 'true' && seen && !forced);

    if (skipIt) {
      if (root.parentNode) root.parentNode.removeChild(root);
      return;
    }

    try { window.sessionStorage.setItem(KEY, '1'); } catch (e) {}

    var done = false;
    function cleanup() {
      if (done) return;
      done = true;
      if (root.parentNode) root.parentNode.removeChild(root);
    }
    // whatever happens, never leave the page covered
    window.setTimeout(cleanup, 7000);

    root.classList.add('lwl-paper--on');

    // keep the page from scrolling underneath without hiding the scrollbar (which would shift the layout)
    function stopScroll(e) { e.preventDefault(); }
    root.addEventListener('wheel', stopScroll, { passive: false });
    root.addEventListener('touchmove', stopScroll, { passive: false });

    // the backdrop hides the page (which may still be loading) until the sheet opens; it can be switched off
    var backdrop = null;
    if (root.dataset.cover !== 'false') {
      backdrop = document.createElement('div');
      backdrop.className = 'lwl-paper__backdrop';
      root.appendChild(backdrop);
    }

    var fading = false;
    function fadeOut(ms) {
      if (fading) return;
      fading = true;
      var fade = root.animate([{ opacity: 1 }, { opacity: 0 }], { duration: ms, easing: 'ease', fill: 'forwards' });
      fade.onfinish = cleanup;
      fade.oncancel = cleanup;
    }

    // tap, click or Escape skips the intro
    root.addEventListener('click', function () { fadeOut(220); });
    window.addEventListener('keydown', function (e) { if (e.key === 'Escape') fadeOut(220); });

    function loadImage(src, cls, w, h) {
      return new Promise(function (resolve, reject) {
        var img = new Image();
        try { img.fetchPriority = 'high'; } catch (e) {}
        img.className = cls;
        img.alt = '';
        img.width = w;
        img.height = h;
        img.onload = function () {
          if (img.decode) img.decode().then(function () { resolve(img); }, function () { resolve(img); });
          else resolve(img);
        };
        img.onerror = reject;
        img.src = src;
      });
    }

    // start both downloads now; the ball is needed first, the sheet about a second later
    var ballPromise = loadImage('{{ 'lwl-paper-ball.webp' | asset_url }}', 'lwl-paper__ball', 457, 541);
    var sheetPromise = loadImage('{{ 'lwl-paper-sheet.webp' | asset_url }}', 'lwl-paper__sheet', 1107, 1453);
    var sheet = null;
    sheetPromise.then(function (img) {
      sheet = img;
      if (!done) root.appendChild(img);
    }, function () {});

    // if the ball cannot be shown quickly, skip the intro rather than keep the page covered
    var started = false;
    var ballTimer = window.setTimeout(function () { if (!started) fadeOut(260); }, 1500);

    ballPromise.then(function (ball) {
      if (done || fading) return;
      started = true;
      window.clearTimeout(ballTimer);
      root.appendChild(ball);
      var t0 = performance.now();

      // 1) the ball pops in, then rocks gently
      ball.animate(
        [
          { transform: 'scale(0.15) rotate(-28deg)', opacity: 0 },
          { transform: 'scale(1.1) rotate(6deg)', opacity: 1, offset: 0.65 },
          { transform: 'scale(1) rotate(0deg)', opacity: 1 }
        ],
        { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.3, 1)', fill: 'both' }
      );
      var rock = ball.animate(
        [
          { transform: 'rotate(-3.5deg) translateY(0)' },
          { transform: 'rotate(3.5deg) translateY(-7px)' },
          { transform: 'rotate(-3.5deg) translateY(0)' }
        ],
        { duration: 900, delay: 320, iterations: Infinity, easing: 'ease-in-out' }
      );

      // 2) after a short hold (and once the page has loaded, for at most 0.3s more), it opens
      function tryOpen() {
        if (done || fading) return;
        var elapsed = performance.now() - t0;
        var pageReady = document.readyState === 'complete' || elapsed > 600 + 300;
        if (elapsed >= 600 && pageReady && sheet) { openUp(); return; }
        if (elapsed > 600 + 1400 && !sheet) { fadeOut(300); return; } // the sheet never arrived: just reveal the page
        window.setTimeout(tryOpen, 50);
      }
      window.setTimeout(tryOpen, 600);

      function openUp() {
        var cur = window.getComputedStyle(ball).transform;
        rock.cancel();
        // the ball swells and fades as the sheet unfolds in its place, and the backdrop clears to show the page
        ball.animate(
          [{ transform: cur === 'none' ? 'scale(1)' : cur, opacity: 1 }, { transform: 'scale(2) rotate(18deg)', opacity: 0 }],
          { duration: 300, easing: 'cubic-bezier(0.5, 0, 0.9, 0.6)', fill: 'forwards' }
        );
        sheet.animate(
          [
            { transform: 'scale(0.45) rotate(-7deg)', opacity: 0 },
            { transform: 'scale(1.03) rotate(0.5deg)', opacity: 1, offset: 0.55 },
            { transform: 'scale(1) rotate(0deg)', opacity: 1 }
          ],
          { duration: 360, delay: 60, easing: 'cubic-bezier(0.2, 0.9, 0.3, 1)', fill: 'both' }
        );
        if (backdrop) backdrop.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 360, delay: 140, easing: 'ease', fill: 'forwards' });

        // 3) the camera pushes through the tear: the sheet zooms past, the live page is revealed
        var push = sheet.animate(
          [
            { transform: 'scale(1)', opacity: 1 },
            { transform: 'scale(3.4)', opacity: 1, offset: 0.7 },
            { transform: 'scale(4.8)', opacity: 0 }
          ],
          { duration: 580, delay: 700, easing: 'cubic-bezier(0.55, 0, 0.9, 0.55)', fill: 'forwards' }
        );
        push.onfinish = cleanup;
        push.oncancel = cleanup;
      }
    }, function () { fadeOut(200); });
  })();
</script>

{% schema %}
{
  "name": "LWL Paper Intro",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "once_per_session",
      "label": "Play once per visit",
      "info": "When on, it plays the first time someone opens the page and not again until they return later. Add ?lwlpaper=1 to the page address to preview it any time. It is skipped for people who prefer reduced motion and inside the theme editor.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cover_page",
      "label": "Cover the page while the paper ball appears",
      "info": "When off, the ball pops straight onto the live page instead.",
      "default": true
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop color",
      "info": "The color covering the page at first (when the option above is on).",
      "default": "#fcc0c5"
    }
  ],
  "presets": [
    { "name": "LWL Paper Intro" }
  ]
}
{% endschema %}
