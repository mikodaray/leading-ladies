{%- style -%}
  #LwlEventDetails-{{ section.id }} {
    font-family: 'RocaOne', var(--font-heading-family);
    padding: 6rem 2rem;
    background: #ed3a31;
    text-align: center;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__heading {
    font-size: clamp(2.8rem, 4.5vw, 4rem);
    color: #ffffff;
    margin: 0 0 4rem;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__grid {
    max-width: 110rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: 2.4rem;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__card {
    background: #ffffff;
    border-radius: 1.6rem;
    padding: 3.2rem 2.4rem;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: translateY(2.4rem);
    transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.3s ease;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__card.is-visible:hover {
    box-shadow: 0 1.6rem 3.5rem rgba(0, 0, 0, 0.25);
    transform: translateY(-0.5rem);
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__icon {
    display: block;
    font-size: 4rem;
    line-height: 1;
    margin: 0 0 1.4rem;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__label {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.25rem;
    text-transform: uppercase;
    color: #ed3a31;
    margin: 0 0 0.8rem;
  }

  #LwlEventDetails-{{ section.id }} .lwl-details__value {
    font-size: 2.1rem;
    line-height: 1.35;
    color: #121212;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #LwlEventDetails-{{ section.id }} .lwl-details__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{%- endstyle -%}

<div id="LwlEventDetails-{{ section.id }}" class="lwl-details">
  {%- if section.settings.heading != blank -%}
    <h2 class="lwl-details__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="lwl-details__grid">
    {%- for block in section.blocks -%}
      <div class="lwl-details__card" data-lwl-reveal {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="lwl-details__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <h3 class="lwl-details__label">{{ block.settings.label | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.value != blank -%}
          <p class="lwl-details__value">{{ block.settings.value | escape | replace: ' | ', '<br>' }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var cards = document.querySelectorAll('#LwlEventDetails-{{ section.id }} [data-lwl-reveal]');
    if (!cards.length) return;
    if (!('IntersectionObserver' in window)) {
      cards.forEach(function (c) { c.classList.add('is-visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function () { entry.target.classList.add('is-visible'); }, i * 90);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    cards.forEach(function (c) { observer.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "LWL Event Details",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Event Details" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value", "info": "Use \" | \" to start a new line." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWL Event Details",
      "blocks": [
        { "type": "detail", "settings": { "icon": "📅", "label": "Date", "value": "November 14, 2026 | Saturday" } },
        { "type": "detail", "settings": { "icon": "⏰", "label": "Time", "value": "10:00 AM – 4:00 PM" } },
        { "type": "detail", "settings": { "icon": "📍", "label": "Location", "value": "Greyhound Café, Ayala Triangle Gardens, Makati City" } },
        { "type": "detail", "settings": { "icon": "🎟️", "label": "Ticket Price", "value": "₱4,999" } }
      ]
    }
  ]
}
{% endschema %}
